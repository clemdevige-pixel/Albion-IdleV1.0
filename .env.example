# Client public configuration
VITE_API_ORIGIN=https://api.example.com

# Server public configuration
NODE_ENV=production
SERVER_HOST=0.0.0.0
# Managed hosts normally inject PORT automatically. SERVER_PORT overrides it.
SERVER_PORT=3000
CLIENT_ORIGIN=https://example.vercel.app
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Discord OAuth (never expose the secret through VITE_* variables)
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://api.example.com/auth/discord/callback
