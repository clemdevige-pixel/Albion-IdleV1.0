{
  "name": "@game/client",
  "version": "0.10.5",
  "private": true,
  "type": "module",
  "description": "React + Vite + Phaser client. Phase 01: bootstrap shell only, no gameplay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@game/core": "workspace:*",
    "@game/data": "workspace:*",
    "@game/gameplay": "workspace:*",
    "@game/persistence": "workspace:*",
    "@game/shared": "workspace:*",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
