{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@game/shared": ["./packages/shared/src/index.ts"],
      "@game/core": ["./packages/core/src/index.ts"],
      "@game/data": ["./packages/data/src/index.ts"],
      "@game/gameplay": ["./packages/gameplay/src/index.ts"],
      "@game/persistence": ["./packages/persistence/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
