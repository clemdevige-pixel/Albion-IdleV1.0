{
  "name": "albion-idle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Albion Idle — monorepo (Phase 01: Repository Bootstrap).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "tsc -b && pnpm --filter @game/client build",
    "typecheck": "tsc -b && pnpm --filter @game/client typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "tsx packages/tooling/src/bin/validate-data.ts",
    "validate:assets": "tsx packages/tooling/src/bin/validate-assets.ts",
    "benchmark:weapon-roles": "tsx --tsconfig tsconfig.base.json scripts/runtime-weapon-role-world-sweep.ts",
    "benchmark:boss-roles": "tsx --tsconfig tsconfig.base.json scripts/runtime-boss-role-telemetry.ts",
    "benchmark:boss-only": "tsx --tsconfig tsconfig.base.json scripts/runtime-boss-only-role-telemetry.ts",
    "benchmark:blue-contract": "tsx --tsconfig tsconfig.base.json scripts/runtime-blue-progression-contract-audit.ts",
    "benchmark:t5-t8-walls": "tsx --tsconfig tsconfig.base.json scripts/runtime-t5-t8-world-wall-sweep.ts",
    "benchmark:t5-t8-wall-candidates": "tsx --tsconfig tsconfig.base.json scripts/runtime-t5-t8-world-wall-candidate-sweep.ts",
    "benchmark:tier-transitions": "tsx --tsconfig tsconfig.base.json scripts/runtime-tier-transition-contract-audit.ts",
    "benchmark:tier-transition-candidates": "tsx --tsconfig tsconfig.base.json scripts/runtime-tier-transition-candidate-sweep.ts",
    "benchmark:t4-frostpeak-gate-candidates": "tsx --tsconfig tsconfig.base.json scripts/runtime-t4-frostpeak-gate-candidate-sweep.ts",
    "benchmark:broadsword-walls": "tsx --tsconfig tsconfig.base.json scripts/runtime-broadsword-wall-audit.ts",
    "benchmark:broadsword-vs-dagger": "tsx --tsconfig tsconfig.base.json scripts/runtime-broadsword-vs-dagger-encounters.ts",
    "benchmark:enchantment-shards": "tsc -b && tsx --tsconfig tsconfig.base.json scripts/runtime-enchantment-shard-progression.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
