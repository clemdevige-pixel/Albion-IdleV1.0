{
  "name": "albion-idle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Albion Idle — deterministic idle RPG monorepo.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @game/client build",
    "typecheck": "tsc -b && pnpm --filter @game/client typecheck",
    "lint": "eslint . && pnpm validate:architecture && pnpm validate:test-workspace && pnpm validate:source-artifacts",
    "lint:fix": "eslint . --fix && pnpm validate:architecture && pnpm validate:test-workspace && pnpm validate:source-artifacts",
    "test": "tsc -b tsconfig.build.json && vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:architecture": "tsx scripts/architecture-boundary-check.ts",
    "validate:test-workspace": "tsx scripts/test-workspace-coverage-check.ts",
    "validate:source-artifacts": "tsx scripts/generated-source-artifact-check.ts",
    "validate:data": "tsx packages/tooling/src/bin/validate-data.ts",
    "validate:assets": "tsx packages/tooling/src/bin/validate-assets.ts",
    "generate:item-icons": "tsx packages/tooling/src/bin/generate-item-icons.ts",
    "benchmark:weapon-roles": "tsx --tsconfig tsconfig.base.json scripts/runtime-weapon-role-world-sweep.ts",
    "benchmark:boss-roles": "tsx --tsconfig tsconfig.base.json scripts/runtime-boss-role-telemetry.ts",
    "benchmark:boss-only": "tsx --tsconfig tsconfig.base.json scripts/runtime-boss-only-role-telemetry.ts",
    "benchmark:blue-contract": "tsx --tsconfig tsconfig.base.json scripts/runtime-blue-progression-contract-audit.ts",
    "benchmark:dungeons": "tsx --tsconfig tsconfig.base.json scripts/runtime-dungeon-benchmark.ts",
    "benchmark:tower": "tsx --tsconfig tsconfig.base.json scripts/runtime-tower-benchmark.ts",
    "benchmark:tower-t5-endless": "tsx --tsconfig tsconfig.base.json scripts/runtime-tower-t5-endless-benchmark.ts",
    "benchmark:global-enchantment-walls": "tsx --tsconfig tsconfig.base.json scripts/runtime-global-enchantment-wall-matrix.ts",
    "benchmark:enchantment-walls": "tsx --tsconfig tsconfig.base.json scripts/runtime-enchantment-progression-audit.ts",
    "benchmark:final-gates": "tsx --tsconfig tsconfig.base.json scripts/runtime-final-gate-audit.ts",
    "benchmark:tier-transitions": "tsx --tsconfig tsconfig.base.json scripts/runtime-tier-plateau-audit.ts",
    "benchmark:enchantment-shards": "tsc -b && tsx --tsconfig tsconfig.base.json scripts/runtime-enchantment-shard-progression.ts",
    "benchmark:cross-tier-world-farm": "tsx --tsconfig tsconfig.base.json scripts/runtime-cross-tier-world-farm-audit.ts",
    "benchmark:global-balance": "node scripts/run-global-balance.mjs",
    "clean": "tsc -b --clean && tsc -b tsconfig.build.json --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
