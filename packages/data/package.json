{
  "name": "@game/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema definitions and validating loaders for game content and asset manifests. Data only, no domain rules.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@game/shared": "workspace:*",
    "zod": "^3.24.1"
  }
}
