{
  "name": "@game/tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build-time tooling: content and asset validation used by scripts and CI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "validate:data": "tsx src/bin/validate-data.ts",
    "validate:assets": "tsx src/bin/validate-assets.ts"
  },
  "dependencies": {
    "@game/data": "workspace:*"
  }
}
